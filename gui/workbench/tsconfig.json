{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": false, "skipLibCheck": true, "noEmit": true, "types": ["vscode"], "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["*.ts"],
  "exclude": ["vite.config.ts", "node_modules", "dist"]
}
